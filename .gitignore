# =============================================================================
# RAGOps — Root .gitignore
# =============================================================================

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
*.whl
pip-wheel-metadata/
.tox/
.nox/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.cover
test_mlflow.db
test_mlflow*.db
mlruns.db

# ── Linting / Type checking ─────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Environment / Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
id_ed25519
id_ed25519.pub
id_rsa
id_rsa.pub
*.p12
*.pfx
secrets/

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── MLflow local artifacts ───────────────────────────────────────────────────
mlruns/
mlartifacts/
mlflow_data/

# ── Ollama bind-mount (model weights ~2GB + SSH keys — never commit) ─────────
ollama_data/

# ── DVC ──────────────────────────────────────────────────────────────────────
# Track .dvc config but not cached data
/data/processed/*.jsonl
/data/processed/*.csv
.dvc/cache/
.dvc/tmp/

# ── Raw PubMed dumps (3,706 files, ~16 MB — managed via DVC, not git) ───────
/data/raw/

# ── Data artifacts ───────────────────────────────────────────────────────────
data/chroma_store/
data/quality_report.html
ablation_outputs/
eval_outputs/
benchmark_results/
*.ragas.json

# ── Local run/debug artifacts ────────────────────────────────────────────────
debug_logs/
*.pid
.cache/
.tmp/

# ── Claude Code ──────────────────────────────────────────────────────────────
.claude/

# ── Project-specific ignores (pre-existing) ──────────────────────────────────
PROGRESS.md
CLAUDE.md
Solo_plan.md

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── OS generated ─────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak

# ── Stray JS tooling (not part of the Python project) ───────────────────────
node_modules/
package.json
package-lock.json

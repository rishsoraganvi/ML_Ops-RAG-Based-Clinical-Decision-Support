# =============================================================================
# RAGOps — Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# ── Service Versions ──────────────────────────────────────────────────────────
CHROMA_VERSION=0.5.3
MLFLOW_VERSION=v2.13.0
OLLAMA_VERSION=latest
PYTHON_VERSION=3.11

# ── Service Ports ─────────────────────────────────────────────────────────────
CHROMA_PORT=8000
MLFLOW_PORT=5000
OLLAMA_PORT=11434
FASTAPI_PORT=8080

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Set to true in dev to allow collection resets via API
CHROMA_ALLOW_RESET=false
CHROMA_COLLECTION_NAME=clinical_docs

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_EXPERIMENT_NAME=ragops_clinical
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Ollama / LLaMA-3 ─────────────────────────────────────────────────────────
OLLAMA_MODEL=llama3:8b
# Keep model resident in GPU VRAM between requests (reduces latency)
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=2

# ── NVIDIA GPU ────────────────────────────────────────────────────────────────
NVIDIA_GPU_COUNT=1

# ── PSI Drift Detection Thresholds (PAPER CONTRIBUTION) ──────────────────────
# PSI in [0, 0.1)   → stable, no action
# PSI in [0.1, 0.25) → WARNING logged to MLflow
# PSI >= 0.25        → ALERT, triggers automated KB refresh
PSI_WARNING_THRESHOLD=0.1
PSI_ALERT_THRESHOLD=0.25
PSI_NUM_BINS=10                    # histogram bins for PSI computation

# ── XAI Consistency Monitoring (XAI CONTRIBUTION) ────────────────────────────
# Cosine similarity of SHAP explanation vectors vs. baseline
# score >= 0.75         → stable
# score in [0.60, 0.75) → WARNING
# score < 0.60          → explanation instability ALERT
XAI_WARNING_THRESHOLD=0.75
XAI_ALERT_THRESHOLD=0.60
XAI_BENCHMARK_QUESTIONS=10        # number of CI benchmark questions for baseline

# ── RAGAS Quality Gates (CI/CD) ───────────────────────────────────────────────
RAGAS_FAITHFULNESS_MIN=0.80
RAGAS_CONTEXT_RECALL_MIN=0.75
RAGAS_ANSWER_RELEVANCY_MIN=0.75

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=production             # production | development
